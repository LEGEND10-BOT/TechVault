[CmdletBinding()]
param(
    [string]$FixturePath = "",
    [string]$SourceMediaPath = "",
    [string]$Language = "auto",
    [string]$OutputRoot = "",
    [int]$Threads = 8,
    [switch]$IncludeMedium,
    [switch]$RunCancellation
)

$ErrorActionPreference = "Stop"
$RepoRoot = "D:\Builds\whisper.cpp-p1c"
$PinnedCommit = "371b5a7" # ggml-org/whisper.cpp v1.9.3 release commit
$UpstreamUrl = "https://github.com/ggml-org/whisper.cpp.git"
$ModelsRoot = "D:\Models\whisper"
if ([string]::IsNullOrWhiteSpace($OutputRoot)) { $OutputRoot = Join-Path $PSScriptRoot "results" }
$BuildRoot = Join-Path $RepoRoot "build"
$LogRoot = Join-Path $OutputRoot "logs"

New-Item -ItemType Directory -Force -Path $OutputRoot,$LogRoot,$ModelsRoot | Out-Null
$Started = Get-Date
$Report = [ordered]@{
    schema_version = 1
    task = "P1-C desktop whisper.cpp feasibility"
    started_local = $Started.ToString("o")
    host = [ordered]@{
        os = (Get-CimInstance Win32_OperatingSystem).Caption
        os_version = (Get-CimInstance Win32_OperatingSystem).Version
        cpu = (Get-CimInstance Win32_Processor | Select-Object -First 1 -ExpandProperty Name)
        logical_processors = [Environment]::ProcessorCount
        total_ram_bytes = [int64](Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory
        powershell = $PSVersionTable.PSVersion.ToString()
        cmake = ""
        git = ""
        ffmpeg = ""
    }
    source = [ordered]@{ url=$UpstreamUrl; pinned_commit=$PinnedCommit; actual_commit=""; }
    fixture = [ordered]@{ path=""; sha256=""; duration_seconds=$null; provenance="Official whisper.cpp sample jfk.wav unless owner fixture supplied"; language=$Language; }
    audio_decode = [ordered]@{ attempted=$false; source=""; output=""; elapsed_seconds=$null; exit_code=$null; }
    models = @()
    cancellation = [ordered]@{ requested=[bool]$RunCancellation; status="NOT_RUN"; reason="Requires an owner-authorized long-form fixture of at least 90 seconds."; }
    corrupted_input = [ordered]@{ status="NOT_RUN"; exit_code=$null; log=""; }
    notes = @()
}

function Get-CommandVersion([string]$Name, [string[]]$VersionArgs=@("--version")) {
    $cmd = Get-Command $Name -ErrorAction SilentlyContinue
    if (-not $cmd) { throw "Required command not found: $Name" }
    $v = (& $Name @VersionArgs 2>&1 | Select-Object -First 1)
    return [string]$v
}
function Get-WavDuration([string]$Path) {
    $bytes = [IO.File]::ReadAllBytes($Path)
    if ($bytes.Length -lt 44 -or [Text.Encoding]::ASCII.GetString($bytes,0,4) -ne "RIFF") { return $null }
    $channels = [BitConverter]::ToInt16($bytes,22)
    $sampleRate = [BitConverter]::ToInt32($bytes,24)
    $byteRate = [BitConverter]::ToInt32($bytes,28)
    $bitsPerSample = [BitConverter]::ToInt16($bytes,34)
    $dataSize = [BitConverter]::ToInt32($bytes,40)
    if ($byteRate -le 0 -or $sampleRate -ne 16000 -or $channels -ne 1 -or $bitsPerSample -ne 16) {
        throw "Fixture must be 16 kHz, mono, PCM 16-bit WAV. Convert using: ffmpeg -i input -ar 16000 -ac 1 -c:a pcm_s16le fixture.wav"
    }
    return [math]::Round($dataSize / $byteRate, 3)
}
function Invoke-MeasuredProcess([string]$Exe, [string[]]$Arguments, [string]$Stdout, [string]$Stderr) {
    $quoted = ($Arguments | ForEach-Object { '"' + ($_ -replace '"','\"') + '"' }) -join ' '
    $timer = [Diagnostics.Stopwatch]::StartNew()
    $p = Start-Process -FilePath $Exe -ArgumentList $quoted -PassThru -NoNewWindow `
        -RedirectStandardOutput $Stdout -RedirectStandardError $Stderr
    $peak = 0L; $peakPrivate = 0L; $cpuStart = 0.0
    try { $cpuStart = $p.TotalProcessorTime.TotalSeconds } catch {}
    while (-not $p.HasExited) {
        try {
            $p.Refresh()
            if ($p.WorkingSet64 -gt $peak) { $peak = [int64]$p.WorkingSet64 }
            if ($p.PrivateMemorySize64 -gt $peakPrivate) { $peakPrivate = [int64]$p.PrivateMemorySize64 }
        } catch {}
        Start-Sleep -Milliseconds 250
    }
    $p.Refresh()
    $timer.Stop()
    $elapsed = [math]::Max(0.001, $timer.Elapsed.TotalSeconds)
    $cpu = 0.0
    try { $cpu = $p.TotalProcessorTime.TotalSeconds - $cpuStart } catch {}
    return [ordered]@{ exit_code=$p.ExitCode; peak_working_set_bytes=$peak; peak_private_bytes=$peakPrivate; cpu_seconds=[math]::Round($cpu,3); wall_seconds=[math]::Round($elapsed,3) }
}

function Invoke-CancellationProbe([string]$Exe, [string]$Model, [string]$Audio, [string]$OutFile, [int]$ThreadCount) {
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $Exe
    $psi.Arguments = ('-m "'+$Model+'" -f "'+$Audio+'" -t '+$ThreadCount)
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $proc = New-Object System.Diagnostics.Process
    $proc.StartInfo = $psi
    $script:cancelOutput = [System.Collections.Concurrent.ConcurrentQueue[string]]::new()
    $proc.add_OutputDataReceived({ if ($EventArgs.Data) { $script:cancelOutput.Enqueue($EventArgs.Data) } })
    $proc.add_ErrorDataReceived({ if ($EventArgs.Data) { $script:cancelOutput.Enqueue("[stderr] "+$EventArgs.Data) } })
    [void]$proc.Start()
    $proc.BeginOutputReadLine(); $proc.BeginErrorReadLine()
    $watch = [Diagnostics.Stopwatch]::StartNew()
    $sawSegment = $false
    while (-not $proc.HasExited -and $watch.Elapsed.TotalSeconds -lt 60) {
        Start-Sleep -Milliseconds 200
        $items = @($script:cancelOutput.ToArray())
        if ($items | Where-Object { $_ -match '\[\d\d:\d\d:\d\d\.\d{3}\s+-->' }) {
            $sawSegment = $true
            break
        }
    }
    if (-not $proc.HasExited) { Start-Sleep -Seconds 5 }
    $wasRunning = -not $proc.HasExited
    if ($wasRunning) { $proc.Kill(); $proc.WaitForExit() }
    $watch.Stop()
    $all = @($script:cancelOutput.ToArray())
    $all | Set-Content -Encoding UTF8 $OutFile
    $segments = @($all | Where-Object { $_ -match '\[\d\d:\d\d:\d\d\.\d{3}\s+-->' }).Count
    return [ordered]@{
        process_was_killed = $wasRunning
        first_segment_seen = $sawSegment
        captured_segment_lines = $segments
        elapsed_seconds = [math]::Round($watch.Elapsed.TotalSeconds,2)
        output_log = $OutFile
        result = if ($wasRunning -and $segments -gt 0) { "PASS_STDOUT_CAPTURE_SURVIVES_HARD_KILL_ONLY" } elseif ($wasRunning) { "FAIL_NO_PARTIAL_SEGMENTS_CAPTURED" } else { "NOT_TESTED_PROCESS_FINISHED_BEFORE_KILL" }
        limitation = "This tests CLI stdout capture by the harness, not a TechVault job callback or graceful cancellation implementation."
    }
}

try {
    $Report.host.cmake = Get-CommandVersion "cmake"
    $Report.host.git = Get-CommandVersion "git"
    $ff = Get-Command ffmpeg -ErrorAction SilentlyContinue
    if ($ff) { $Report.host.ffmpeg = (& ffmpeg -version 2>&1 | Select-Object -First 1) }
    else { $Report.notes += "FFmpeg not found; non-WAV conversion test skipped." }

    if (-not [string]::IsNullOrWhiteSpace($SourceMediaPath)) {
        if (-not $ff) { throw "SourceMediaPath was supplied but FFmpeg is not available on PATH." }
        if (-not (Test-Path $SourceMediaPath)) { throw "Source media not found: $SourceMediaPath" }
        $converted = Join-Path $OutputRoot "fixture-16k-mono.wav"
        $decodeTimer = [Diagnostics.Stopwatch]::StartNew()
        & ffmpeg -y -i $SourceMediaPath -ar 16000 -ac 1 -c:a pcm_s16le $converted 2> (Join-Path $LogRoot "ffmpeg-decode.stderr.txt")
        $decodeExit = $LASTEXITCODE
        $decodeTimer.Stop()
        $Report.audio_decode = [ordered]@{ attempted=$true; source=(Resolve-Path $SourceMediaPath).Path; output=$converted; elapsed_seconds=[math]::Round($decodeTimer.Elapsed.TotalSeconds,3); exit_code=$decodeExit }
        if ($decodeExit -ne 0) { throw "FFmpeg decode failed ($decodeExit); see ffmpeg-decode.stderr.txt" }
        $FixturePath = $converted
        $Report.fixture.provenance = "Owner-supplied source media decoded locally by FFmpeg"
    }

    if (-not (Test-Path (Join-Path $RepoRoot ".git"))) {
        New-Item -ItemType Directory -Force -Path (Split-Path $RepoRoot -Parent) | Out-Null
        git clone --filter=blob:none $UpstreamUrl $RepoRoot
        if ($LASTEXITCODE -ne 0) { throw "git clone failed ($LASTEXITCODE)" }
    }
    git -C $RepoRoot fetch --tags --force
    if ($LASTEXITCODE -ne 0) { throw "git fetch failed ($LASTEXITCODE)" }
    git -C $RepoRoot checkout --detach $PinnedCommit
    if ($LASTEXITCODE -ne 0) { throw "checkout of pinned upstream commit failed ($LASTEXITCODE)" }
    $Report.source.actual_commit = (git -C $RepoRoot rev-parse HEAD).Trim()
    if (-not $Report.source.actual_commit.StartsWith($PinnedCommit)) { throw "Pinned source mismatch." }

    cmake -S $RepoRoot -B $BuildRoot
    if ($LASTEXITCODE -ne 0) { throw "CMake configure failed ($LASTEXITCODE)" }
    cmake --build $BuildRoot --config Release --parallel $Threads
    if ($LASTEXITCODE -ne 0) { throw "whisper.cpp build failed ($LASTEXITCODE)" }

    $Candidates = @(
        (Join-Path $BuildRoot "bin\Release\whisper-cli.exe"),
        (Join-Path $BuildRoot "bin\whisper-cli.exe")
    )
    $Cli = $Candidates | Where-Object { Test-Path $_ } | Select-Object -First 1
    if (-not $Cli) { throw "Build succeeded but whisper-cli.exe was not found in expected output paths." }

    if ([string]::IsNullOrWhiteSpace($FixturePath)) {
        $FixturePath = Join-Path $RepoRoot "samples\jfk.wav"
    }
    if (-not (Test-Path $FixturePath)) { throw "Fixture not found: $FixturePath" }
    $FixturePath = (Resolve-Path $FixturePath).Path
    $duration = Get-WavDuration $FixturePath
    if (-not $duration) { throw "Fixture must be PCM WAV. Convert with ffmpeg to 16 kHz mono PCM S16LE." }
    $Report.fixture.path = $FixturePath
    $Report.fixture.sha256 = (Get-FileHash -Algorithm SHA256 $FixturePath).Hash
    $Report.fixture.duration_seconds = $duration

    $modelNames = @("tiny","base","small")
    if ($IncludeMedium -or $Report.host.total_ram_bytes -ge 16GB) { $modelNames += "medium" }
    foreach ($modelName in $modelNames) {
        $modelPath = Join-Path $ModelsRoot ("ggml-" + $modelName + ".bin")
        if (-not (Test-Path $modelPath)) {
            $url = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$modelName.bin"
            Invoke-WebRequest -Uri $url -OutFile $modelPath
        }
        $modelHash = (Get-FileHash -Algorithm SHA256 $modelPath).Hash
        $prefix = Join-Path $LogRoot $modelName
        $stdout = "$prefix.stdout.txt"; $stderr = "$prefix.stderr.txt"
        $cliArgs = @("-m",$modelPath,"-f",$FixturePath,"-t",$Threads,"-oj","-of",$prefix)
        if ($Language -ne "auto") { $cliArgs += @("-l",$Language) }
        $measurement = Invoke-MeasuredProcess $Cli $cliArgs $stdout $stderr
        $rtf = if ($duration -gt 0) { [math]::Round($measurement.wall_seconds / $duration,3) } else { $null }
        $jsonPath = "$prefix.json"
        $segmentCount = $null
        if (Test-Path $jsonPath) {
            try { $j = Get-Content $jsonPath -Raw | ConvertFrom-Json; $segmentCount = @($j.transcription).Count } catch {}
        }
        $Report.models += [ordered]@{
            model=$modelName; model_path=$modelPath; model_bytes=(Get-Item $modelPath).Length
            model_sha256=$modelHash; measurement=$measurement; realtime_factor=$rtf
            segment_count=$segmentCount; json_output=$jsonPath; stdout=$stdout; stderr=$stderr
        }
    }

    # Isolated malformed-input check: a child process must fail cleanly, not crash the host.
    $bad = Join-Path $OutputRoot "invalid-input.wav"
    [IO.File]::WriteAllBytes($bad,[Text.Encoding]::ASCII.GetBytes("not a valid wave file"))
    $badOut = Join-Path $LogRoot "invalid.stdout.txt"; $badErr = Join-Path $LogRoot "invalid.stderr.txt"
    $badRun = Invoke-MeasuredProcess $Cli @("-m",(Join-Path $ModelsRoot "ggml-tiny.bin"),"-f",$bad,"-t","2") $badOut $badErr
    $Report.corrupted_input.exit_code = $badRun.exit_code
    $Report.corrupted_input.log = $badErr
    $Report.corrupted_input.status = if ($badRun.exit_code -ne 0) { "PASS_CHILD_PROCESS_REJECTED_INPUT" } else { "REVIEW_UNEXPECTED_SUCCESS" }

    if ($RunCancellation) {
        if ($duration -lt 90) {
            $Report.cancellation.status = "SKIPPED_FIXTURE_TOO_SHORT"
            $Report.cancellation.reason = "Fixture duration is under 90 seconds; provide an owner-authorized long fixture and rerun."
        } else {
            $cancelLog = Join-Path $LogRoot "cancellation.stdout.txt"
            $cancel = Invoke-CancellationProbe $Cli (Join-Path $ModelsRoot "ggml-tiny.bin") $FixturePath $cancelLog $Threads
            $Report.cancellation = $cancel
            $Report.cancellation.requested = $true
        }
    }

    $Report.notes += "RTF = fixture audio seconds / measured wall seconds; values >1 indicate faster-than-real-time."
    $Report.notes += "Models tested: Tiny, Base, Small; Medium is included when detected RAM is at least 16 GiB or -IncludeMedium is supplied."
    $Report.notes += "Language defaults to auto-detection; use -Language ur (or another supported language code) for a forced-language comparison."
    $Report.notes += "Peak Working Set and Private Bytes are sampled every 250 ms; brief peaks may be missed. Private Bytes is the primary memory comparison metric per D-019/P1-J."
    $Report.notes += "The SHA-256 values record downloaded artifact identity; they are not a publisher signature verification."
    $Report.notes += "A1 build, A2 quality, A3 RTF, A4 memory, A6 malformed-input behavior and A9 timestamp accuracy require human review of saved evidence. A5 needs a long-form fixture and explicit interruption run."
}
catch {
    $Report.notes += ("FATAL: " + $_.Exception.Message)
    $Report.notes += "Execution stopped; no acceptance criteria are marked PASS by this script."
}
finally {
    $Report.finished_local = (Get-Date).ToString("o")
    $Report.duration_seconds = [math]::Round(((Get-Date) - $Started).TotalSeconds,2)
    $jsonOut = Join-Path $OutputRoot "P1-C-desktop-results.json"
    $Report | ConvertTo-Json -Depth 10 | Set-Content -Encoding UTF8 $jsonOut
    Write-Host "P1-C evidence written to: $jsonOut"
    Write-Host "Review build/transcription logs under: $LogRoot"
}
