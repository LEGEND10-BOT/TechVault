{
  "name": "techvault",
  "version": "0.1.0",
  "private": true,
  "description": "TechVault desktop application (Phase 2 M0 scaffold). Licensing of the distributed product is still an open decision (P-024).",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "tauri": "tauri",
    "check:csp": "node scripts/check-csp.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
